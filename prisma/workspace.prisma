  title          String
  body           String
  /// Error context (HELP). The fingerprint groups the same error across threads; see packages/core/src/error-fingerprint.ts.
  errorMessage   String?
  errorFingerprint String?
  language       String?
  filePath       String?
  line           Int?
  codeSnippet    String?
  branch         String?
  commitSha      String?
  answerId       String?            @unique @db.Uuid
  solvedAt       DateTime?
  pinned         Boolean            @default(false)
  locked         Boolean            @default(false)
  replyCount     Int                @default(0)
  lastActivityAt DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User              @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answer  DiscussionReply?  @relation("DiscussionAnswer", fields: [answerId], references: [id], onDelete: SetNull)
  replies DiscussionReply[] @relation("DiscussionReplies")

  @@unique([projectId, number])
  @@index([projectId, lastActivityAt(sort: Desc)])
  @@index([projectId, errorFingerprint])
}

model DiscussionReply {
  id           String    @id @default(uuid(7)) @db.Uuid
  discussionId String    @db.Uuid
  projectId    String    @db.Uuid
  authorId     String
  body         String
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  discussion Discussion       @relation("DiscussionReplies", fields: [discussionId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answerOf   Discussion?      @relation("DiscussionAnswer")
  votes      DiscussionVote[]

  @@index([discussionId, createdAt])
}

/// "This helped": one per person per reply.
model DiscussionVote {
  replyId   String   @db.Uuid
  userId    String
  createdAt DateTime @default(now())

  reply DiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([replyId, userId])
}

// ── Huddles ──────────────────────────────────────────────────

enum HuddleKind {
  /// A call: a meeting link.
  HUDDLE
  /// Live coding: a VS Code Live Share link.
  PAIR
}

/// An invitation to talk or pair now. Short-lived; invitees get a notification with the link.
model Huddle {
  id        String     @id @default(uuid(7)) @db.Uuid
  projectId String     @db.Uuid
  hostId    String
  kind      HuddleKind @default(HUDDLE)
  url       String
  topic     String?
  invitees  String[]
  createdAt DateTime   @default(now())
  endsAt    DateTime
  endedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  host    User    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}
