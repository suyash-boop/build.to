# Copy to .env and fill in. Local dev uses Docker containers for Postgres + Valkey.
#
# Postgres:  docker run --name build-to -e POSTGRES_USER=buildto -e POSTGRES_PASSWORD=buildto \
#              -e POSTGRES_DB=buildto -p 5440:5432 -v build-to-pgdata:/var/lib/postgresql/data postgres:15
# Valkey:    docker run --name build-to-redis -p 6380:6379 valkey/valkey:latest

DATABASE_URL="postgresql://buildto:buildto@localhost:5440/buildto?schema=public"
REDIS_URL="redis://localhost:6380"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Project A login providers (separate from the optional repository integration).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Project B shares DATABASE_URL, REDIS_URL and the BetterAuth identity above.
WEB_ORIGIN="http://localhost:3000"
AUTH_INTERNAL_URL="http://127.0.0.1:3000"
PROJECTS_WEB_URL="http://127.0.0.1:3002"
API_INTERNAL_URL="http://127.0.0.1:4000"
API_HOST="127.0.0.1"
API_PORT="4000"
# npm run dev derives stable local-only defaults from BETTER_AUTH_SECRET when
# these are empty. Set independent persistent values for any non-dev deployment.
ENCRYPTION_KEY=""
COOKIE_SECRET=""

# Optional GitHub App: not needed for manual projects/tasks/discussions.
# Callback: http://localhost:3000/projects/api/auth/github/callback
# Setup URL: http://localhost:3000/projects/new
# Webhook: http://localhost:3000/projects/api/webhooks/github
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
ANTHROPIC_API_KEY=""
WORK_RECORD_SIGNING_KEY=""

# Required only when publishing B's legal pages in a production deployment.
LEGAL_ENTITY_NAME=""
CONTACT_EMAIL=""
GOVERNING_LAW=""
POLICY_EFFECTIVE_DATE=""
