{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // esbuild bundles to CommonJS for VS Code; type-check the ESM sources as a bundler sees them.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node", "vscode"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src", "test"]
}
