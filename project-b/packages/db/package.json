{
  "name": "@bldt/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "npm run db:migrate --prefix ../../..",
    "migrate:deploy": "npm run db:deploy --prefix ../../..",
    "seed": "tsx --env-file-if-exists=../../../.env src/seed.ts",
    "studio": "npm run db:studio --prefix ../../..",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:prod": "npm run db:deploy --prefix ../../..",
    "seed:prod": "tsx src/seed.ts",
    "migrate:test": "node ../../../scripts/prepare-integration-db.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
