{
  "name": "bld.to",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["project-b/apps/*", "project-b/packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:a": "concurrently -n web,worker,board -c blue,magenta,green \"npm:dev:web\" \"npm:dev:worker\" \"npm:dev:board\"",
    "dev:projects": "node scripts/dev.mjs --projects-only",
    "dev:web": "next dev",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:board": "tsx watch worker/board.ts",
    "build": "npm run db:generate && next build && npm run build -w @bldt/web && npm run build -w @bldt/api && npm run build -w @bldt/worker",
    "build:a": "next build",
    "start": "node scripts/start.mjs",
    "start:a": "next start",
    "lint": "eslint app components lib worker scripts tests",
    "db:migrate": "prisma migrate dev",
    "db:generate": "node scripts/workspace-schema.mjs && prisma generate && npm run generate -w @bldt/db",
    "db:deploy": "prisma migrate deploy",
    "db:seed:projects": "npm run seed -w @bldt/db",
    "typecheck": "tsc --noEmit --incremental false && npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "tsx tests/merge.integration.mts",
    "test:prepare": "node scripts/prepare-integration-db.mjs",
    "test:browser": "tsx tests/browser-smoke.mts",
    "test:projects": "npm run test -w @bldt/contracts -w @bldt/core -w @bldt/github -w @bldt/ai -w bldt",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.9",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.11.1",
    "next": "16.4.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "overrides": { "esbuild": "^0.28.2" },
  "devDependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "express": "^5.2.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
